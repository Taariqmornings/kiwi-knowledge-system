# =============================================================================
# Kiwi — Offline Knowledge Base System
# Environment Variables
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Edit .env and fill in any values you want to override.
#   3. The app loads .env automatically via the start.ps1 launcher.
#      For manual runs, activate your venv and export the variables yourself.
#
# NOTE: All variables are OPTIONAL. The defaults work out of the box for a
# standard local install. Only change what you actually need to customise.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# Absolute or relative path to the SQLite knowledge database.
# The file is created automatically on first run.
# Default: backend/data/knowledge.db
#
# DATABASE_PATH=


# -----------------------------------------------------------------------------
# OLLAMA — LOCAL AI CHAT  (optional feature)
# -----------------------------------------------------------------------------
#
# Kiwi's AI chat sidebar streams answers from a local Ollama daemon.
# All search and article browsing features work WITHOUT Ollama installed.
# Only the chat sidebar requires it.
#
# SETUP:
#   1. Install Ollama from https://ollama.com
#   2. Start the daemon:      ollama serve
#   3. Pull the default model: ollama pull gemma3:1b
#
# If OLLAMA_HOST is unreachable at startup, Kiwi disables the chat feature
# gracefully — no crash, no error screen.

# URL of your Ollama daemon.
# Default: http://127.0.0.1:11434
#
# OLLAMA_HOST=http://127.0.0.1:11434

# The Ollama model to use for RAG chat.
# Any model pulled via `ollama pull <name>` works here.
# Lighter alternatives: phi3:mini, llama3.2:1b, qwen2.5:1.5b
# Default: gemma3:1b
#
# OLLAMA_MODEL=gemma3:1b


# -----------------------------------------------------------------------------
# INDEXING PERFORMANCE  (advanced — safe to leave at defaults)
# -----------------------------------------------------------------------------

# Number of articles committed to SQLite per batch during indexing.
# Higher values are faster but use more RAM. Lower values are safer on
# machines with limited memory.
# Default: 1000
#
# INDEX_BATCH_SIZE=1000

# Maximum character length stored in the article summary field.
# Default: 500
#
# MAX_SUMMARY_LENGTH=500


# -----------------------------------------------------------------------------
# SERVER LIMITS  (advanced)
# -----------------------------------------------------------------------------

# Maximum size of an incoming request body in megabytes.
# Default: 50
#
# MAX_REQUEST_SIZE_MB=50

# API rate limit — maximum requests per minute per IP address.
# Default: 60
#
# RATE_LIMIT_PER_MINUTE=60


# -----------------------------------------------------------------------------
# ELECTRON / FRONTEND
# -----------------------------------------------------------------------------

# Set to 1 to force Electron to load the Vite HMR dev server instead of
# the pre-built dist/ folder. The start.ps1 launcher sets this automatically
# depending on the -Dev flag, so you rarely need to touch this.
# Default: 0
#
# KIWI_FORCE_DEV=0
