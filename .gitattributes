# Normalize line endings and mark binary files so Git never rewrites them.
* text=auto

# Source code — LF endings everywhere.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.ini text eol=lf
*.toml text eol=lf
*.cfg text eol=lf

# Binary assets — never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg binary
*.zim binary
*.gguf binary
*.db binary
*.db-wal binary
*.db-shm binary

# Lockfiles
package-lock.json text eol=lf